# Controls what the `docker build` context sends to the daemon (and what
# `gcloud run deploy --source` uploads, if no .gcloudignore existed -- see
# .gcloudignore for that path's own, slightly different rules).
#
# Keep this INCLUSIVE of everything the Dockerfile's build stage needs:
# pnpm-lock.yaml, pnpm-workspace.yaml, and every workspace package.json
# (currently: root, packages/api, packages/widget, packages/adapters/mcp --
# see the Dockerfile's comment on why those are the only ones today).

# Dependencies -- reinstalled fresh inside the image; a host-built
# node_modules can carry native bindings for the wrong OS/arch.
node_modules
**/node_modules

# Build output -- regenerated by `pnpm -r build` inside the Dockerfile; a
# stale local dist could otherwise mask a real build failure.
**/dist

# VCS / local tooling.
.git
.claude

# Secrets -- values are passed in as container/Cloud Run env vars, never
# baked into the image.
.env
.env.*

# Python: local virtualenv + caches. Runtime installs pytz/icalendar/requests
# fresh into /opt/venv (see Dockerfile); connectors-py's own test deps
# (pytest, responses) are never needed to run the API.
.venv
__pycache__
**/__pycache__
*.pyc
.pytest_cache
**/*.egg-info

# Not needed to build/run the API image (WordPress plugin is a separate
# deployment target, generated by tools/adapter-gen; its output has no
# package.json today, so excluding it doesn't affect
# `pnpm install --frozen-lockfile` -- see .gcloudignore for the same check).
platforms/
platforms_out/

# Docs and scratch/session files.
docs
tmp

# Misc.
.DS_Store
coverage
