rules_version = '2';

// Only the Admin SDK (packages/api's Firestore repositories, using
// applicationDefault credentials on Cloud Run, or FIRESTORE_EMULATOR_HOST
// locally/in CI) ever talks to this database -- there is no client-side
// Firestore access from the widget or anywhere else. Admin SDK requests
// bypass these rules entirely, so this simply denies any direct
// client-SDK access that was never intended to exist.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
