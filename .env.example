# Core
NODE_ENV=development
PORT=3000
# Absolute origin this API is reachable at. Used to rewrite servers[0].url
# in the served /openapi.json and the URLs in
# /.well-known/ai-actions.json. Leave unset to derive it from each
# incoming request (correct behind Cloud Run's proxy, which the app trusts
# for X-Forwarded-Proto).
PUBLIC_API_BASE=http://localhost:3000
WEB_APP_BASE=http://localhost:5173

# Database & cache
# Leave DATABASE_URL UNSET to run fully in-memory (the hosted demo does
# this): appointments, services and OAuth tokens live in process memory
# and vanish on restart.
DATABASE_URL=postgres://user:pass@localhost:5432/smb
REDIS_URL=redis://localhost:6379

# Admin API (POST /v1/services). X-Admin-Key must equal this value.
# Unset => the endpoint answers 503 'admin API not configured'.
ADMIN_API_KEY=replace_me_with_a_long_random_string

# When set, the API ensures this account has two demo services with stable
# ids at startup (svc_demo_consult: 30min/0 buffer, svc_demo_full:
# 60min/10 buffer). Idempotent. Needed for the in-memory demo deployment,
# where nothing survives a cold start.
SEED_DEMO_ACCOUNT=acct_demo

# Business-hours availability fallback, used by GET /v1/availability when
# no calendar provider is connected. Comma-separated entries of
# "<Day>[-<Day>] HH:MM-HH:MM"; day names are three letters, and a range
# may wrap the week ("Fri-Mon"). BUSINESS_TZ is an IANA zone.
BUSINESS_HOURS=Mon-Fri 09:00-17:00,Sat 10:00-14:00
BUSINESS_TZ=America/New_York

# Where the built browser widget lives, for GET /widget.js and /widget/*.
# Defaults to packages/widget/dist relative to the api package; a missing
# directory only warns and 404s.
WIDGET_DIST_DIR=packages/widget/dist

# Auth/JWT
JWT_SECRET=replace_me_with_32+_chars

# OAuth calendar token encryption at rest (Postgres oauth_tokens table).
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=replace_me_with_openssl_rand_base64_32

# Providers (OAuth)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/google/callback

MS_CLIENT_ID=your_ms_app_id
MS_CLIENT_SECRET=your_ms_secret
MS_REDIRECT_URI=http://localhost:3000/oauth/microsoft/callback
MS_TENANT=common

# ICS fallback
ICS_CACHE_TTL_SEC=600

# Email/SMS
EMAIL_PROVIDER=ses
EMAIL_FROM="Bookings <no-reply@example.com>"
AWS_REGION=us-east-1
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxx
TWILIO_FROM=+15551234567

# LLM routing
OPENAI_API_KEY=sk-your-key
LLM_PRIMARY=gpt-5-nano
LLM_FALLBACK=gpt-5-mini
LLM_ROUTE_THRESHOLD=0.35

# HMAC for agent calls
AGENT_HMAC_SECRET=replace_me_also

# Stripe Billing
STRIPE_SECRET=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
PLAN_STARTER_PRICE_ID=price_xxx
PLAN_PRO_PRICE_ID=price_yyy
USAGE_METER_PRICE_ID=price_zzz
